[Desktop Entry]
# The console's PRIMARY launcher entry, for every desktop including Omarchy
# (TOON_Network#140, ADR 0028). `packaging/desktop/toon-console-web.desktop`
# is the second entry, "TOON Console (web)", for the browser app this one
# used to open by default.
#
# @BIN@ is the launcher and @ICON@ is either an icon theme NAME (the package,
# which installs into hicolor) or an absolute path to a file (a checkout,
# which installs nothing into an icon theme). Both are what the Desktop Entry
# spec allows in Icon=, and both are substituted at install time --
# `packaging/aur/PKGBUILD` for the package, `toon-console-install` for a
# checkout.
#
# Exec is the LAUNCHER and not a bare command, because the launcher has to
# make sure the daemon is running first: with no arguments it ensures the
# daemon, then hands `toon-console-tui` to `omarchy-launch-or-focus-tui`
# (which focuses the terminal that is already open rather than starting a
# second one) or, off Omarchy, to `xdg-terminal-exec`/`$TERMINAL`.
# Terminal=false because the launcher opens its OWN terminal window for the
# TUI; a Terminal=true here would additionally wrap the launcher script
# itself in one.
Version=1.0
Type=Application
Name=TOON Console
GenericName=Workload console
Comment=Run workloads on TOON Network
Exec=@BIN@
Icon=@ICON@
Terminal=false
StartupNotify=true
# Network with RemoteAccess under it, and one main category only:
# `desktop-file-validate` warns that an entry with two main categories can
# appear twice in a menu, and running someone else's machine from here is
# remote access if anything is.
Categories=Network;RemoteAccess;
Keywords=TOON;workload;lease;provider;nostr;
