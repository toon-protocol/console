#!/usr/bin/env bash
#
# Install the console for the current user: the systemd --user service, the
# launcher, the desktop entry and the Omarchy integration.
#
# Everything this script writes lands under $HOME. Nothing here needs root,
# and nothing here is system-wide, because the daemon is a user service
# holding one person's keys (ADR 0019).
#
# It runs in one of two LAYOUTS, and works out which by where it is:
#
#   checkout   packaging/bin/toon-console-install in a built checkout. It
#              writes the launcher into ~/.local/bin and the unit into
#              ~/.config/systemd/user, pointing both at this checkout.
#
#   packaged   /usr/bin/toon-console-install, from the AUR package
#              (TOON_Network#100). The launcher, the unit, the UI, the docs
#              and the desktop entry are already in /usr and belong to pacman,
#              so this writes NONE of them: it enables the service, installs
#              the Omarchy integration, and leaves a copy of the uninstaller
#              in ~/.local/bin so that removing the package can still be
#              undone after the package is gone.
#
# `--repo <dir>` forces the first, `--prefix <dir>` the second.
#
# The Omarchy half (TOON_Network#99) is the same either way, because those
# files are the PERSON's and live in ~/.config however the console got here:
# the themed template the console's colours come from, the theme-set hook that
# re-themes an open window, the three menu entries, and a post-update hook
# that catches the console up with `omarchy update`. Each is one file, each is
# removed again by toon-console-uninstall, and the menu file — which belongs
# to the person — is edited only between this package's own markers.
#
# NOTHING here reads or writes the console's DATA directory
# ($XDG_DATA_HOME/toon-console). Installing, re-installing and upgrading all
# leave an account's channel state, Lease Vault cache and keystore alone.
#
# Usage: toon-console-install [--repo <dir> | --prefix <dir>]
#                             [--no-webapp] [--no-omarchy] [--no-retheme]
#                             [--omarchy-only]

set -euo pipefail

REPO=""
PREFIX=""
INSTALL_WEBAPP=true
INSTALL_OMARCHY=true
RETHEME=true
OMARCHY_ONLY=false
APP_NAME="TOON Console"

usage() {
  echo "usage: toon-console-install [--repo <dir> | --prefix <dir>] [--no-webapp] [--no-omarchy] [--no-retheme] [--omarchy-only]" >&2
  exit 1
}

while (($#)); do
  case "$1" in
  --repo)
    REPO="${2:?--repo needs a directory}"
    shift 2
    ;;
  --prefix)
    # Where the package installed itself: <prefix>/bin, <prefix>/lib and
    # <prefix>/share. /usr in real life; a throwaway root when this is being
    # tested without installing anything.
    PREFIX="${2:?--prefix needs a directory}"
    shift 2
    ;;
  --no-webapp)
    INSTALL_WEBAPP=false
    shift
    ;;
  --no-omarchy)
    INSTALL_OMARCHY=false
    shift
    ;;
  --no-retheme)
    RETHEME=false
    shift
    ;;
  --omarchy-only)
    # The desktop integration alone: the themed template, the theme-set hook,
    # the menu entries and the post-update hook, with the service and the
    # launcher left exactly as they are. What the post-update hook wants, and
    # what a checkout that is already running wants when only these files have
    # changed.
    OMARCHY_ONLY=true
    shift
    ;;
  *)
    usage
    ;;
  esac
done

die() {
  echo "toon-console-install: $1" >&2
  exit 1
}

[[ -z $REPO || -z $PREFIX ]] || die "--repo and --prefix are two different layouts; pass one"

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ -z $REPO && -z $PREFIX ]]; then
  if [[ -d $SELF_DIR/../../packages/daemon ]]; then
    REPO="$(cd "$SELF_DIR/../.." && pwd)"
  elif [[ -d $SELF_DIR/../lib/toon-console ]]; then
    PREFIX="$(cd "$SELF_DIR/.." && pwd)"
  else
    die "cannot tell which layout this is; pass --repo <checkout> or --prefix <prefix>"
  fi
fi

BIN_DIR="${XDG_BIN_HOME:-$HOME/.local/bin}"
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
DESKTOP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
OMARCHY_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy"
THEME_STATE="$HOME/.local/state/omarchy/current"

if [[ -n $PREFIX ]]; then
  LAYOUT=packaged
  # Absolute, because a hook and a menu entry run with a PATH that is not this
  # login shell's.
  BIN="$PREFIX/bin/toon-console"
  INSTALLER="$PREFIX/bin/toon-console-install"
  UNINSTALLER="$PREFIX/bin/toon-console-uninstall"
  ASSETS="$PREFIX/share/toon-console"
  OMARCHY_SRC="$ASSETS/omarchy"
  DESKTOP_SOURCE=""
  ICON_SOURCE=""
else
  LAYOUT=checkout
  BIN="$BIN_DIR/toon-console"
  INSTALLER="$REPO/packaging/bin/toon-console-install"
  UNINSTALLER="$REPO/packaging/bin/toon-console-uninstall"
  OMARCHY_SRC="$REPO/packaging/omarchy"
  DESKTOP_SOURCE="$REPO/packaging/desktop/toon-console.desktop"
  ICON_SOURCE="$REPO/packaging/icons/toon-console.png"
  DAEMON_ENTRY="$REPO/packages/daemon/dist/main.js"
  UI_ROOT="$REPO/packages/ui/dist"
  DOCS_DIR="$REPO/docs"
fi

# --------------------------------------------------------------------------
# The Omarchy half (TOON_Network#99, TOON_Network#100)
# --------------------------------------------------------------------------

# The console's colours come from the current theme through a template in
# ~/.config/omarchy/themed/, an open window is re-themed by a hook in
# hooks/theme-set.d/, and hooks/post-update.d/ catches a console up with an
# `omarchy update` that replaced its package under it. All three are ordinary
# user files with the conventions the samples beside them document; none is
# generated and none is a copy of anything Omarchy owns.
install_omarchy() {
  [[ -d $OMARCHY_DIR ]] || {
    echo "No $OMARCHY_DIR — skipping the Omarchy integration."
    return 0
  }

  mkdir -p "$OMARCHY_DIR/themed" "$OMARCHY_DIR/hooks/theme-set.d" \
    "$OMARCHY_DIR/hooks/post-update.d" "$OMARCHY_DIR/extensions"

  local template="$OMARCHY_DIR/themed/toon-console.css.tpl"
  local before="" after=""
  # An `[[ ... ]] && x=y` here would take `set -e` out with it the first time
  # the template is not there yet, which is every first install.
  if [[ -r $template ]]; then
    before="$(cksum <"$template")"
  fi
  install -m 0644 "$OMARCHY_SRC/toon-console.css.tpl" "$template"
  after="$(cksum <"$template")"

  # The hooks run from omarchy-hook, whose PATH is not this shell's, so what
  # they call is named absolutely -- the same reason the unit is.
  sed -e "s|@BIN@|$BIN|g" "$OMARCHY_SRC/theme-set.d/toon-console" \
    >"$OMARCHY_DIR/hooks/theme-set.d/toon-console"
  chmod 0644 "$OMARCHY_DIR/hooks/theme-set.d/toon-console"

  sed -e "s|@INSTALL@|$INSTALLER|g" "$OMARCHY_SRC/post-update.d/toon-console" \
    >"$OMARCHY_DIR/hooks/post-update.d/toon-console"
  chmod 0644 "$OMARCHY_DIR/hooks/post-update.d/toon-console"

  merge_menu

  # A template is rendered when a theme is SET, so a template that has just
  # changed -- or one whose rendered colours are missing -- has nothing on disk
  # for the daemon to read until the next theme change. Setting the current
  # theme again is the supported way to render one now: it is the same code
  # path a theme switch takes and it is idempotent.
  #
  # Only when something actually changed, though. This runs from the
  # post-update hook on every `omarchy update`, and re-theming the desktop is
  # not a free thing to do to somebody in the middle of one.
  local rendered="$THEME_STATE/theme/toon-console.css"
  if [[ $RETHEME == true ]] && [[ $before != "$after" || ! -r $rendered ]] &&
    command -v omarchy-theme-set >/dev/null 2>&1 && [[ -r $THEME_STATE/theme.name ]]; then
    omarchy-theme-set "$(cat "$THEME_STATE/theme.name")" >/dev/null || true
  fi

  echo "Omarchy: themed template, theme-set and post-update hooks, and menu entries installed."
}

# The menu file belongs to the person: it is JSONC with their comments in it,
# and parsing and rewriting it would lose them. So the entries go in as LINES,
# between markers, and come out again the same way. Nothing else in the file is
# read or changed.
#
# The block goes in at the TOP, straight after the opening brace, and every one
# of its entries ends in a comma. That is what makes removing it a plain
# deletion: appending at the bottom would mean putting a comma on whatever
# entry was last, and the uninstaller could never know whether that comma had
# been theirs. Omarchy's own reader strips a trailing comma before a closing
# brace, so a file that held nothing but this block parses too.
merge_menu() {
  local menu="$OMARCHY_DIR/extensions/omarchy-menu.jsonc"
  local block
  block=$(sed -e "s|@BIN@|$BIN|g" "$OMARCHY_SRC/menu.jsonc")

  MENU_FILE="$menu" MENU_BLOCK="$block" node -e '
    const { readFileSync, writeFileSync } = require("node:fs");
    const file = process.env.MENU_FILE;
    const start = "  // >>> toon-console (managed by toon-console-install; edits here are lost)";
    const end = "  // <<< toon-console";
    const block = process.env.MENU_BLOCK
      .split("\n")
      .map((line) => (line === "" ? "" : `  ${line}`))
      .join("\n");

    let text = "";
    try {
      text = readFileSync(file, "utf8");
    } catch {
      text = "{\n}\n";
    }

    // Idempotent: whatever this package put here last time comes out first.
    const held = new RegExp(`${escape(start)}[\\s\\S]*?${escape(end)}\n`, "g");
    text = text.replace(held, "");

    const lines = text.split("\n");
    let at = 0;
    while (at < lines.length && (lines[at].trim() === "" || lines[at].trim().startsWith("//"))) {
      at += 1;
    }
    if (lines[at] === undefined || !lines[at].trim().startsWith("{")) {
      throw new Error(`${file} does not open with an object; leaving it alone.`);
    }

    lines.splice(at + 1, 0, start, block, end);
    writeFileSync(file, lines.join("\n"));

    function escape(value) {
      return value.replace(/[.*+?^${}()|[\]\\\/]/g, "\\$&");
    }
  '
  echo "Menu: three entries in $menu, between this package's own markers."
}

if [[ $OMARCHY_ONLY == true ]]; then
  if [[ $INSTALL_OMARCHY == true ]]; then
    install_omarchy
  fi
  exit 0
fi

# --------------------------------------------------------------------------
# The service, the launcher and the desktop entry
# --------------------------------------------------------------------------

if [[ $LAYOUT == checkout ]]; then
  [[ -f $DAEMON_ENTRY ]] || die "no built daemon at $DAEMON_ENTRY — run 'npm run build' first"
  [[ -d $UI_ROOT ]] || die "no built UI at $UI_ROOT — run 'npm run build' first"

  NODE_BIN="$(command -v node)" || die "node is not on PATH"

  mkdir -p "$BIN_DIR" "$UNIT_DIR"

  # The launcher, on PATH.
  install -m 0755 "$REPO/packaging/bin/toon-console" "$BIN"

  # The unit, with this checkout's absolute paths substituted in. systemd does
  # not expand $PATH or relative paths in ExecStart, so they have to be
  # resolved here rather than left as placeholders.
  sed \
    -e "s|@NODE@|$NODE_BIN|g" \
    -e "s|@DAEMON@|$DAEMON_ENTRY|g" \
    -e "s|@UI_ROOT@|$UI_ROOT|g" \
    -e "s|@DOCS_DIR@|$DOCS_DIR|g" \
    "$REPO/packaging/systemd/toon-console.service" >"$UNIT_DIR/toon-console.service"
else
  # The package put the launcher in $PREFIX/bin, the unit in
  # $PREFIX/lib/systemd/user and the daemon in $PREFIX/lib/toon-console, all
  # owned by pacman. Writing any of them again under $HOME would SHADOW the
  # package's copy -- a unit in ~/.config/systemd/user wins over one in
  # /usr/lib/systemd/user -- and would outlive the package it came from.
  [[ -f $PREFIX/lib/toon-console/daemon/main.js ]] ||
    die "no daemon at $PREFIX/lib/toon-console/daemon/main.js — is the package installed?"
  [[ -f $PREFIX/lib/systemd/user/toon-console.service ]] ||
    die "no unit at $PREFIX/lib/systemd/user/toon-console.service — is the package installed?"
  [[ -d $ASSETS/ui ]] || die "no UI at $ASSETS/ui — is the package installed?"

  # The uninstaller, kept where the package cannot take it away. Removing the
  # package removes $PREFIX/bin/toon-console-uninstall along with everything
  # else it owns, and the per-user half -- the enabled service, the Omarchy
  # files -- would then have nothing left to remove it. This copy is what
  # `pacman -R` leaves behind on purpose, and it deletes itself when it runs.
  mkdir -p "$BIN_DIR"
  install -m 0755 "$UNINSTALLER" "$BIN_DIR/toon-console-uninstall"
fi

command -v systemctl >/dev/null 2>&1 || die "systemctl not found; this console is a systemd --user service"
systemctl --user daemon-reload
systemctl --user enable toon-console.service
# `restart` rather than `start`: running this after an upgrade or a rebuild is
# how the new build gets to be the one that is running, and `start` on a live
# daemon does nothing at all. It starts one that is not running too, which is
# the whole of what `start` would have done. The start limit is cleared first,
# or a unit that hit it refuses to start even once its cause is fixed -- the
# same reason the launcher clears it.
systemctl --user reset-failed toon-console.service >/dev/null 2>&1 || true
systemctl --user restart toon-console.service

if [[ $LAYOUT == checkout ]]; then
  if [[ $INSTALL_WEBAPP == true ]] && command -v omarchy-webapp-install >/dev/null 2>&1; then
    # Arguments are: name, url, icon, custom-exec.
    #
    # The URL is the daemon's base and is NOT what gets opened: the custom exec
    # is, because the URL that opens the window carries a token minted at
    # launch and cannot be written into a .desktop file at install time.
    # omarchy still requires a valid http(s) URL in that position, so the base
    # is what it gets.
    omarchy-webapp-install \
      "$APP_NAME" \
      "http://127.0.0.1:7797" \
      "$ICON_SOURCE" \
      "$BIN"
    echo "Installed the '$APP_NAME' web app. SUPER + SPACE to launch it."
  else
    # Any other desktop gets a plain desktop entry (ADR 0019). Same file the
    # package installs system-wide, with this checkout's paths in it.
    mkdir -p "$DESKTOP_DIR"
    sed -e "s|@BIN@|$BIN|g" -e "s|@ICON@|$ICON_SOURCE|g" "$DESKTOP_SOURCE" \
      >"$DESKTOP_DIR/toon-console.desktop"
    echo "Installed $DESKTOP_DIR/toon-console.desktop."
  fi
else
  # The package's own /usr/share/applications/toon-console.desktop is the
  # launcher entry, on Omarchy as much as anywhere else: it runs the same
  # launcher the menu entries do, and that launcher is what opens the web-app
  # window. `omarchy-webapp-install` is deliberately not run here — it would
  # write a SECOND "TOON Console" into ~/.local/share/applications, and the
  # person would have two identical entries, one of which pacman cannot
  # remove.
  echo "Launcher: $PREFIX/share/applications/toon-console.desktop (from the package)."
fi

if [[ $INSTALL_OMARCHY == true ]]; then
  install_omarchy
fi

echo "Daemon: systemctl --user status toon-console.service"
echo "Open:   toon-console"
