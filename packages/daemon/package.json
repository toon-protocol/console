{
  "name": "@toon-protocol/console-daemon",
  "version": "0.1.0",
  "private": true,
  "description": "The TOON Console daemon: a systemd --user service that serves the console UI and its local API on 127.0.0.1",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "toon-console-daemon": "dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "node --watch dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@toon-protocol/client": "3.1.0",
    "nostr-tools": "^2.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
