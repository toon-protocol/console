{
  "name": "@toon-protocol/console-daemon",
  "version": "0.1.0",
  "private": true,
  "description": "The TOON Console daemon: a systemd --user service that serves the console UI and its local API on 127.0.0.1",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "toon-console-daemon": "dist/main.js",
    "toon-docs-publish": "dist/main-docs-publish.js",
    "toon-smoke-console": "dist/main-smoke-console.js",
    "toon-template-publish": "dist/main-template-publish.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "node --watch dist/main.js",
    "docs:publish": "node dist/main-docs-publish.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "smoke:console": "node dist/main-smoke-console.js",
    "template:publish": "node dist/main-template-publish.js"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^1.8.0",
    "@scure/base": "^1.2.0",
    "@toon-protocol/client": "3.1.0",
    "nostr-tools": "^2.25.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
